# Claves de la API de Gemini (aistudio.google.com), separadas por comas. Una por cuenta: cada cuenta suma su propia cuota.
# Solo viven en el servidor; el navegador nunca las ve.
GEMINI_API_KEYS=clave_cuenta_1,clave_cuenta_2

# Opcional. Modelos en orden de preferencia (por defecto: gemini-3-flash-preview, luego gemini-3.8-flash).
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.8-flash
